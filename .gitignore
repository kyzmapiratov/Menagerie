*.AppImage
*.deb
*.rpm
*.pkg.tar.*
packaging/arch/*/pkg/
packaging/arch/*/src/
packaging/arch/*/*.tar.gz

# Editors and desktops
.DS_Store
*.swp
.idea/
.vscode/
.~lock.*#

# UI harness output (pictures a run takes)
tools/ui-harness/out/

# Python bytecode (the UI harness)
__pycache__/
*.pyc
