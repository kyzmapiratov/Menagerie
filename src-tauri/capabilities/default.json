{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*.shimejis.xyz/*" },
        { "url": "https://shimejis.xyz/*" },
        { "url": "https://cachomon.com/*" },
        { "url": "https://github.com/CluelessCatBurger/wl_shimeji*" },
        { "url": "https://aur.archlinux.org/packages/wl_shimeji-plugin-kwinsupport" }
      ]
    }
  ]
}
